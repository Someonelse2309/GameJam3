  m_Script: {fileID: 11500000, guid: 76b1a50459ed34c3d97b020e9943481e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueSentences:
  - speakerName: Tanaka Koji
    sentence: Well well well, look what we have here
  - speakerName: Tanaka Koji
    sentence: "\u9B3C\u6BBA\u3057 (Onikoroshi)\u2026. The ghost slayer\u2026."
  - speakerName: Tanaka Koji
    sentence: "I thought you left this life behind\u2026."
  - speakerName: Michelle Sato
    sentence: "I need your help\u2026."
  - speakerName: Tanaka Koji
    sentence: "Why should I? You should just go home an\u2026."
  - speakerName: Michelle Sato
    sentence: You owe me one, Remember Nagoya?
  - speakerName: Tanaka Koji
    sentence: "I remember\u2026"
  - speakerName: Tanaka Koji
    sentence: "But I\u2019m hungry\u2026"
  - speakerName: Tanaka Koji
    sentence: "Get me something to eat, and we\u2019ll talk\u2026"
