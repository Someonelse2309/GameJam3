  lines:
  - speakerName: Michelle
    text: '"So, Ryu. What do you want to buy today?" '
    voiceLine: {fileID: 0}
    delayAfter: 0.5
  - speakerName: Ryu
    text: '"I want to look at everything, Mom!" '
    voiceLine: {fileID: 0}
    delayAfter: 0.5
  - speakerName: Michelle
    text: '"That''s not very specific." '
    voiceLine: {fileID: 0}
    delayAfter: 0.5
  - speakerName: Ryu
    text: "\"I want to look at the toy store! And the bookstore! And\u2014\" "
    voiceLine: {fileID: 0}
    delayAfter: 0.5
  - speakerName: Michelle
    text: '"We only have one hour, sweetheart." '
    voiceLine: {fileID: 0}
    delayAfter: 0.5
  - speakerName: Ryu
    text: '"Okay..."'
    voiceLine: {fileID: 0}
    delayAfter: 0.5
