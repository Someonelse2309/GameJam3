  m_Script: {fileID: 11500000, guid: e7f2ea0b13210423b860e003efc9029d, type: 3}
  m_Name: Dialogue_Scene1_Momen2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDataEP1
  lines:
  - speakerName: Michelle
    text: I need to buy a new jacket. Winter is coming.
    voiceLine: {fileID: 0}
    delayAfter: 0.5
    characterImage: {fileID: -7034116388857145810, guid: d0361a5ec0b2548e9866f114f4ee1704, type: 3}
    soundEffect: {fileID: 0}
    triggerFadeToBlack: 0
    triggerScreenShake: 0
  - speakerName: Ryu
    text: Mom, wait. I... I want to buy something for you.
    voiceLine: {fileID: 0}
    delayAfter: 0.5
    characterImage: {fileID: 696768212231895392, guid: 9e46c057c0b004f2dafb727a18b8e9a6, type: 3}
    soundEffect: {fileID: 0}
    triggerFadeToBlack: 0
    triggerScreenShake: 0
  - speakerName: Michelle
    text: For me?
    voiceLine: {fileID: 0}
    delayAfter: 0.5
    characterImage: {fileID: -7034116388857145810, guid: d0361a5ec0b2548e9866f114f4ee1704, type: 3}
    soundEffect: {fileID: 0}
    triggerFadeToBlack: 0
    triggerScreenShake: 0
  - speakerName: Ryu
    text: I've been saving my allowance for 3 months. You're the best mom ever.
    voiceLine: {fileID: 0}
    delayAfter: 0.5
    characterImage: {fileID: 696768212231895392, guid: 9e46c057c0b004f2dafb727a18b8e9a6, type: 3}
    soundEffect: {fileID: 0}
    triggerFadeToBlack: 0
    triggerScreenShake: 0
  - speakerName: Michelle
    text: You don't have to, baby. Save it for yourself.
    voiceLine: {fileID: 0}
    delayAfter: 0.5
    characterImage: {fileID: -7034116388857145810, guid: 37f5cd5a5b207408eb29c9a674e099bb, type: 3}
    soundEffect: {fileID: 0}
    triggerFadeToBlack: 0
    triggerScreenShake: 0
  - speakerName: Ryu
    text: No! I want to.
    voiceLine: {fileID: 0}
    delayAfter: 0.5
    characterImage: {fileID: 696768212231895392, guid: 9e46c057c0b004f2dafb727a18b8e9a6, type: 3}
    soundEffect: {fileID: 0}
    triggerFadeToBlack: 0
    triggerScreenShake: 0
